  {
    "rule_id": "cpp-prefer-non-member-binary-operator",
    "language": "cpp",
    "description": "Prefer to define non-modifying binary operators as non-member functions to allow implicit conversions on both sides.",
    "severity": "warning",
    "surface_pattern": {
      "code_snippet": "class $CLASS {\n    ...\n    $RET operator$OP($PARAMS) $CONST {\n        ...\n    }\n    ...\n}",
      "pattern_type": "code_pattern",
      "metavariables": {
        "$CLASS": {
          "type_hint": "class"
        },
        "$RET": {
          "type_hint": "expr"
        },
        "$OP": {
          "type_hint": "expr"
        },
        "$PARAMS": {
          "type_hint": "expr"
        },
        "$CONST": {
          "type_hint": "expr"
        }
      }
    },
    "context_constraints": [
      {
        "target": "operator$OP",
        "constraint_type": "syntactic",
        "condition": "is_binary_operator",
        "required": "true"
      },
      {
        "target": "operator$OP",
        "constraint_type": "syntactic",
        "condition": "is_non_modifying_operator",
        "required": "true"
      }
    ],
    "dataflow_spec": null,
    "capabilities_required": {
      "cross_file": false,
      "inheritance_analysis": false,
      "dataflow": false,
      "type_resolution": false
    },
    "backend_hints": {
      "semgrep": {
        "partial_support": true,
        "needs_type_solver": false,
        "full_support": false,
        "limitations": "requires pattern to match member operator definitions; may have false positives with modifying operators (e.g., +=)"
      },
      "pmd": {
        "partial_support": false,
        "needs_type_solver": false,
        "full_support": false,
        "limitations": "PMD does not support C/C++ analysis"
      },
      "codeql": {
        "partial_support": true,
        "needs_type_solver": true,
        "full_support": false,
        "limitations": "requires custom query to identify non-modifying binary operators defined as member functions"
      }
    },
    "metadata": {
      "source_file": "D:\\Sepc2Checker\\data\\cpp\\hard_specification\\member_binary_operators.txt",
      "section": "member_binary_operators"
    }
  },

[
  {
    "rule_id": "cpp-avoid-rtti",
    "language": "cpp",
    "description": "Avoid using run-time type information (RTTI) such as typeid or dynamic_cast. Use virtual methods or visitor pattern instead. Allowed in unit tests.",
    "severity": "warning",
    "surface_pattern": {
      "code_snippet": "typeid($EXPR)",
      "pattern_type": "code_pattern",
      "metavariables": {
        "$EXPR": {
          "type_hint": "expr"
        }
      }
    },
    "context_constraints": [
      {
        "target": "file",
        "constraint_type": "scope",
        "condition": "name_not_matches_regex('.*test.*')",
        "required": "true"
      }
    ],
    "dataflow_spec": null,
    "capabilities_required": {
      "cross_file": false,
      "inheritance_analysis": false,
      "dataflow": false,
      "type_resolution": false
    },
    "backend_hints": {
      "semgrep": {
        "partial_support": true,
        "needs_type_solver": false,
        "full_support": false,
        "limitations": "Cannot reliably exclude unit test files without custom configuration."
      },
      "pmd": {
        "partial_support": false,
        "needs_type_solver": false,
        "full_support": false,
        "limitations": "PMD does not support C/C++ analysis."
      },
      "codeql": {
        "partial_support": true,
        "needs_type_solver": false,
        "full_support": false,
        "limitations": "Requires custom query to exclude test files."
      }
    },
    "metadata": {
      "source_file": "D:\\Sepc2Checker\\data\\cpp\\hard_specification\\avoid_rtti.txt",
      "section": "avoid_rtti"
    }
  },

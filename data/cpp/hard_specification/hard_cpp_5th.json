    "backend_hints": {
      "semgrep": {
        "partial_support": true,
        "needs_type_solver": false,
        "full_support": false,
        "limitations": "May not detect all cases where assignment is far from declaration."
      },
      "pmd": {
        "partial_support": false,
        "needs_type_solver": false,
        "full_support": false,
        "limitations": "PMD does not support C/C++ analysis."
      },
      "codeql": {
        "partial_support": true,
        "needs_type_solver": false,
        "full_support": false,
        "limitations": "Requires custom query to detect distance between declaration and first use."
      }
    },
    "metadata": {
      "source_file": "D:\\Sepc2Checker\\data\\cpp\\hard_specification\\variables_declare_close.txt",
      "section": "variables_declare_close"
    }
  },

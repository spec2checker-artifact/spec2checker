  {
    "rule_id": "cpp-meaningful-copy-move",
    "language": "cpp",
    "description": "Support copying and/or moving only if these operations are clear and meaningful for your type. Avoid slicing by making base classes abstract.",
    "severity": "warning",
    "surface_pattern": {
      "code_snippet": "class $CLASS { ... }",
      "pattern_type": "code_pattern",
      "metavariables": {
        "$CLASS": {
          "type_hint": "class"
        }
      }
    },
    "context_constraints": [
      {
        "target": "$CLASS",
        "constraint_type": "syntactic",
        "condition": "has_copy_constructor",
        "required": "true"
      },
      {
        "target": "$CLASS",
        "constraint_type": "syntactic",
        "condition": "has_copy_assignment",
        "required": "true"
      },
      {
        "target": "$CLASS",
        "constraint_type": "syntactic",
        "condition": "has_move_constructor",
        "required": "true"
      },
      {
        "target": "$CLASS",
        "constraint_type": "syntactic",
        "condition": "has_move_assignment",
        "required": "true"
      },
      {
        "target": "$CLASS",
        "constraint_type": "inheritance",
        "condition": "has_base_class",
        "required": "true"
      }
    ],
    "dataflow_spec": null,
    "capabilities_required": {
      "cross_file": false,
      "inheritance_analysis": true,
      "dataflow": false,
      "type_resolution": true
    },
    "backend_hints": {
      "semgrep": {
        "partial_support": true,
        "needs_type_solver": true,
        "full_support": false,
        "limitations": "requires type resolution to check inheritance and special member functions"
      },
      "pmd": {
        "partial_support": false,
        "needs_type_solver": false,
        "full_support": false,
        "limitations": "PMD does not support C/C++ analysis"
      },
      "codeql": {
        "partial_support": true,
        "needs_type_solver": true,
        "full_support": false,
        "limitations": "requires custom query to check for meaningful copy/move semantics"
      }
    },
    "metadata": {
      "source_file": "D:\\Sepc2Checker\\data\\cpp\\hard_specification\\support_copying_meaningful.txt",
      "section": "support_copying_meaningful"
    }

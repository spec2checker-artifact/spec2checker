  {
    "rule_id": "cpp-local-variable-scope",
    "language": "cpp",
    "description": "Local variables should be declared in the narrowest scope possible, as close to first use as possible, and initialized in the declaration.",
    "severity": "warning",
    "surface_pattern": {
      "code_snippet": "$TYPE $VAR;\n...\n$VAR = $EXPR;",
      "pattern_type": "code_pattern",
      "metavariables": {
        "$TYPE": {
          "type_hint": "expr"
        },
        "$VAR": {
          "type_hint": "expr"
        },
        "$EXPR": {
          "type_hint": "expr"
        }
      }
    },
    "context_constraints": [
      {
        "target": "$VAR",
        "constraint_type": "scope",
        "condition": "is_local_variable",
        "required": "true"
      },
      {
        "target": "$VAR",
        "constraint_type": "syntactic",
        "condition": "is_uninitialized_declaration",
        "required": "true"
      }
    ],
    "dataflow_spec": null,
    "capabilities_required": {
      "cross_file": false,
      "inheritance_analysis": false,
      "dataflow": false,
      "type_resolution": false

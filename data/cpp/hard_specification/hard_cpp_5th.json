          "type_hint": "expr"
        }
      }
    },
    "context_constraints": [
      {
        "target": "constructor",
        "constraint_type": "syntactic",
        "condition": "parameter_count == 1",
        "required": "true"
      },
      {
        "target": "constructor",
        "constraint_type": "type",
        "condition": "is_copy_or_move_constructor == false",
        "required": "true"
      },
      {
        "target": "constructor",
        "constraint_type": "annotation",
        "condition": "has_annotation('explicit')",
        "required": "false"
      }

    "severity": "warning",
    "surface_pattern": {
      "code_snippet": "class $CLASS {\n    ...\n    $CLASS(const $CLASS&);\n    $CLASS($CLASS&&);\n    $CLASS& operator=(const $CLASS&);\n    $CLASS& operator=($CLASS&&);\n    ...\n}",
      "pattern_type": "code_pattern",
      "metavariables": {

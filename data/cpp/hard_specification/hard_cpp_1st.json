        "full_support": false,
        "limitations": "PMD does not support C/C++ analysis"
      },
      "codeql": {
        "partial_support": true,
        "needs_type_solver": true,
        "full_support": false,
        "limitations": "requires custom query to detect failing initialization patterns"
      }
    },
    "metadata": {

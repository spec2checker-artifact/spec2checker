  {
    "rule_id": "cpp-avoid-failing-constructor",
    "language": "cpp",
    "description": "Avoid initialization that can fail in constructors if you can't signal an error. Consider factory functions or `Init()` methods.",
    "severity": "warning",
    "surface_pattern": {
      "code_snippet": "$CLASS::$CLASS($ARGS) {\n    ...\n}",
      "pattern_type": "code_pattern",
      "metavariables": {
        "$CLASS": {
          "type_hint": "class"
        },
        "$ARGS": {
          "type_hint": "expr"
        }
      }
    },
    "context_constraints": [
      {
        "target": "constructor",
        "constraint_type": "syntactic",
        "condition": "calls_function_matching('malloc|new|fopen|open|connect|throw')",
        "required": "true"
      }
    ],
    "dataflow_spec": null,
    "capabilities_required": {
      "cross_file": false,
      "inheritance_analysis": false,
      "dataflow": false,
      "type_resolution": false

  {
    "rule_id": "cpp-missing-noexcept",
    "language": "cpp",
    "description": "Detect missing `noexcept` specifier on move constructors and move assignment operators where it is useful for performance and accurately reflects semantics.",
    "severity": "warning",
    "surface_pattern": {
      "code_snippet": "$CLASS($CLASS&& $ARG) $SPECIFIER { ... }",
      "pattern_type": "code_pattern",
      "metavariables": {
        "$CLASS": {
          "type_hint": "class"
        },
        "$ARG": {
          "type_hint": "expr"
        },
        "$SPECIFIER": {
          "type_hint": "expr"
        }
      }
    },
    "context_constraints": [
      {
        "target": "function",
        "constraint_type": "syntactic",
        "condition": "is_move_constructor",
        "required": "true"
      },
      {
        "target": "$SPECIFIER",
        "constraint_type": "syntactic",
        "condition": "not_contains('noexcept')",
        "required": "true"
      }
    ],
    "dataflow_spec": null,
    "capabilities_required": {
      "cross_file": false,
      "inheritance_analysis": false,
      "dataflow": false,
      "type_resolution": false
    },
    "backend_hints": {
      "semgrep": {
        "partial_support": true,
        "needs_type_solver": false,
        "full_support": false,
        "limitations": "May require additional patterns for move assignment operators and complex specifier combinations."
      },
      "pmd": {
        "partial_support": false,
        "needs_type_solver": false,
        "full_support": false,
        "limitations": "PMD does not support C++ analysis."
      },
      "codeql": {
        "partial_support": true,
        "needs_type_solver": true,
        "full_support": false,
        "limitations": "Requires type resolution to accurately identify move constructors/operators and their exception safety guarantees."
      }
    },
    "metadata": {
      "source_file": "D:\\Sepc2Checker\\data\\cpp\\hard_specification\\specify_noexcept_correct.txt",
      "section": "specify_noexcept_correct"
    }

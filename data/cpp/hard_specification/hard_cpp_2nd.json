    "rule_id": "cpp-fallthrough-annotation",
    "language": "cpp",
    "description": "Fall-through from one case label to another must be annotated using `[[fallthrough]];`. Consecutive case labels without code need no annotation.",
    "severity": "warning",
    "surface_pattern": {
      "code_snippet": "case $CASE1:\n    ...\n    $STMT\n    ...\n    case $CASE2:",
      "pattern_type": "code_pattern",
      "metavariables": {
        "$CASE1": {
          "type_hint": "expr"
        },
        "$CASE2": {
          "type_hint": "expr"
        },
        "$STMT": {
          "type_hint": "expr"
        }
      }
    },
    "context_constraints": [
      {
        "target": "$STMT",
        "constraint_type": "syntactic",
        "condition": "not_matches('[[fallthrough]];')",
        "required": "true"
      },
      {
        "target": "$STMT",
        "constraint_type": "syntactic",
        "condition": "not_empty",
        "required": "true"
      }
    ],
    "dataflow_spec": null,
    "capabilities_required": {
      "cross_file": false,
      "inheritance_analysis": false,
      "dataflow": false,
      "type_resolution": false
    },
    "backend_hints": {
      "semgrep": {
        "partial_support": true,
        "needs_type_solver": false,
        "full_support": false,
        "limitations": "requires precise detection of non-empty statements between case labels"
      },
      "pmd": {
        "partial_support": false,
        "needs_type_solver": false,
        "full_support": false,
        "limitations": "PMD does not support C/C++ analysis"
      },
      "codeql": {
        "partial_support": true,
        "needs_type_solver": false,
        "full_support": false,
        "limitations": "requires custom query to detect missing fallthrough annotation"
      }
    },
    "metadata": {
      "source_file": "D:\\Sepc2Checker\\data\\cpp\\hard_specification\\annotate_fall_fallthrough.txt",
      "section": "annotate_fall_fallthrough"
    }
  },

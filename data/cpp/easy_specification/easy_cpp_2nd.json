        "partial_support": true,
        "needs_type_solver": false,
        "full_support": false,
        "limitations": "requires type resolution to verify compile-time constant initialization"
      },
      "pmd": {
        "partial_support": false,
        "needs_type_solver": false,
        "full_support": false,
        "limitations": "PMD does not support C/C++ analysis"
      },
      "codeql": {
        "partial_support": true,
        "needs_type_solver": true,
        "full_support": false,
        "limitations": "requires custom query to check constinit annotation and constant initialization"
      }

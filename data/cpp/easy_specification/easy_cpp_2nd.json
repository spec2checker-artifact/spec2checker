  {
    "rule_id": "cpp-thread-local-constinit",
    "language": "cpp",
    "description": "thread_local variables at class or namespace scope must be initialized with a compile-time constant and annotated with constinit.",
    "severity": "error",
    "surface_pattern": {
      "code_snippet": "thread_local $TYPE $VAR = $INIT;",
      "pattern_type": "code_pattern",
      "metavariables": {
        "$TYPE": {
          "type_hint": "expr"
        },
        "$VAR": {
          "type_hint": "expr"
        },
        "$INIT": {
          "type_hint": "expr"
        }
      }
    },
    "context_constraints": [
      {
        "target": "$VAR",
        "constraint_type": "scope",
        "condition": "is_namespace_or_class_scope"
      },
      {
        "target": "$VAR",
        "constraint_type": "annotation",
        "condition": "constinit",
        "required": "true"
      }
    ],
    "dataflow_spec": null,
    "capabilities_required": {
      "cross_file": false,
      "inheritance_analysis": false,
      "dataflow": false,
      "type_resolution": true

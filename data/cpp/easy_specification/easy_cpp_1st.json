      "pattern_type": "code_pattern",
      "metavariables": {
        "$CLASS": {
          "type_hint": "class"
        },
        "$METHOD": {
          "type_hint": "function"
        },
        "$RET": {
          "type_hint": "expr"
        },
        "$PARAMS": {
          "type_hint": "expr"
        }
      }
    },
    "context_constraints": [
      {
        "target": "method",
        "constraint_type": "syntactic",
        "condition": "is_member_function",
        "required": "true"
      },
      {

        "condition": "is_not_destructor",
        "required": "true"
      },
      {
        "target": "method",
        "constraint_type": "syntactic",
        "condition": "is_not_static",
        "required": "true"
      },
      {
        "target": "method",
        "constraint_type": "syntactic",
        "condition": "is_not_mutable",
        "required": "true"
      },
      {
        "target": "method",
        "constraint_type": "syntactic",
        "condition": "does_not_modify_member",
        "required": "true"
      },
      {
        "target": "method",
        "constraint_type": "syntactic",
        "condition": "does_not_call_non_const_member",
        "required": "true"
      }
    ],
    "dataflow_spec": null,

    "rule_id": "cpp-override-annotation-required",
    "language": "cpp",
    "description": "Annotate overrides of virtual functions with `override` or `final`. Do not use `virtual` when declaring an override.",
    "severity": "warning",
    "surface_pattern": {
      "code_snippet": "virtual $RETURN $FUNC($ARGS) $SPECIFIER? { ... }",
      "pattern_type": "code_pattern",
      "metavariables": {

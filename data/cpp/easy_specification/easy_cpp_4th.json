        "condition": "name_ends_with('_')",
        "required": "false"
      },
      {
        "target": "$MEMBER",
        "constraint_type": "annotation",
        "condition": "const",
        "required": "false"
      },
      {
        "target": "$MEMBER",
        "constraint_type": "syntactic",
        "condition": "is_static",
        "required": "false"
      }
    ],
    "dataflow_spec": null,

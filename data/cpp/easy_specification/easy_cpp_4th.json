          "type_hint": "function"
        }
      }
    },
    "context_constraints": [
      {
        "target": "function",
        "constraint_type": "inheritance",
        "condition": "overrides_virtual_method",
        "required": "true"
      },
      {
        "target": "function",
        "constraint_type": "annotation",
        "condition": "override",
        "required": "false"
      },
      {
        "target": "function",
        "constraint_type": "annotation",
        "condition": "final",
        "required": "false"
      }
    ],
    "dataflow_spec": null,

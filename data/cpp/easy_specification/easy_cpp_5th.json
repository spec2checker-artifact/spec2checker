    "rule_id": "cpp-delete-forbidden-operations",
    "language": "cpp",
    "description": "Use `= delete` to explicitly delete copy/move operations.",
    "severity": "warning",
    "surface_pattern": {
      "code_snippet": "$CLASS($PARAMS) = $OP;",
      "pattern_type": "code_pattern",
      "metavariables": {
        "$CLASS": {
          "type_hint": "class"
        },
        "$PARAMS": {
          "type_hint": "expr"
        },
        "$OP": {
          "type_hint": "expr"
        }
      }
    },
    "context_constraints": [
      {
        "target": "$OP",
        "constraint_type": "syntactic",
        "condition": "is_not('delete')",
        "required": "true"
      },
      {
        "target": "$PARAMS",
        "constraint_type": "syntactic",
        "condition": "matches_pattern('const $CLASS&')",
        "required": "true"
      }
    ],
    "dataflow_spec": null,
    "capabilities_required": {

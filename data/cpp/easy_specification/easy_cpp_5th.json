[
  {
    "rule_id": "cpp-struct-member-naming",
    "language": "cpp",
    "description": "Data members of structs (both static and non-static) are named like ordinary nonmember variables, without trailing underscore.",
    "severity": "warning",
    "surface_pattern": {
      "code_snippet": "struct $STRUCT {\n  ... $TYPE $MEMBER;\n  ...\n};",
      "pattern_type": "code_pattern",
      "metavariables": {
        "$STRUCT": {
          "type_hint": "class"
        },
        "$TYPE": {
          "type_hint": "expr"
        },
        "$MEMBER": {
          "type_hint": "expr",
          "regex": "^.*_$"
        }
      }
    },
    "context_constraints": [
      {
        "target": "$MEMBER",
        "constraint_type": "syntactic",
        "condition": "name_ends_with('_')",
        "required": "true"
      }
    ],
    "dataflow_spec": null,
    "capabilities_required": {
      "cross_file": false,
      "inheritance_analysis": false,
      "dataflow": false,
      "type_resolution": false
    },
    "backend_hints": {
      "semgrep": {
        "partial_support": true,
        "needs_type_solver": false,
        "full_support": false,
        "limitations": "requires pattern to match struct definitions only, not classes"
      },
      "pmd": {
        "partial_support": false,
        "needs_type_solver": false,
        "full_support": false,
        "limitations": "PMD does not support C/C++ analysis"
      },
      "codeql": {
        "partial_support": true,
        "needs_type_solver": true,
        "full_support": false,
        "limitations": "requires distinguishing structs from classes via type resolution"
      }
    },
    "metadata": {
      "source_file": "D:\\Sepc2Checker\\data\\cpp\\easy_specification\\no_trailing_underscore.txt",
      "section": "no_trailing_underscore"
    }
  },

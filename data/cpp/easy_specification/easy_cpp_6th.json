    "rule_id": "cpp-no-namespace-alias-in-header",
    "language": "cpp",
    "description": "Do not use namespace aliases at namespace scope in header files except in explicitly marked internal-only namespaces.",
    "severity": "warning",
    "surface_pattern": {
      "code_snippet": "namespace $ALIAS = $NAMESPACE;",
      "pattern_type": "code_pattern",
      "metavariables": {
        "$ALIAS": {
          "type_hint": "expr"
        },
        "$NAMESPACE": {
          "type_hint": "expr"
        }
      }
    },
    "context_constraints": [
      {
        "target": "file",
        "constraint_type": "syntactic",
        "condition": "file_extension_matches('h|hpp|hh|hxx')",
        "required": "true"
      },
      {
        "target": "declaration",
        "constraint_type": "scope",
        "condition": "is_namespace_scope",
        "required": "true"
      }
    ],
    "dataflow_spec": null,

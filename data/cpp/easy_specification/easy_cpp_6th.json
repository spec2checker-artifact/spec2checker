    "rule_id": "cpp-prefix-increment-decrement",
    "language": "cpp",
    "description": "Use prefix form (++i, --i) for increment/decrement operators unless the old value is needed, as prefix is never less efficient.",
    "severity": "warning",
    "surface_pattern": {
      "code_snippet": "$EXPR $OP $EXPR2",
      "pattern_type": "code_pattern",
      "metavariables": {
        "$OP": {
          "type_hint": "expr",
          "regex": "i\\+\\+|i--"
        }
      }
    },
    "context_constraints": [

    "rule_id": "cpp-namespace-termination-comment",
    "language": "cpp",
    "description": "Multi-line namespace definitions must be terminated with a comment indicating the namespace name.",
    "severity": "warning",
    "surface_pattern": {
      "code_snippet": "namespace $NS {\n  ...\n}",
      "pattern_type": "code_pattern",
      "metavariables": {

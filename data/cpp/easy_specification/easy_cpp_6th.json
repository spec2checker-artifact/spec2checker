    "rule_id": "cpp-include-guard-format",
    "language": "cpp",
    "description": "Use #define guards with format <PROJECT>_<PATH>_<FILE>_H_ based on full path in source tree.",
    "severity": "warning",
    "surface_pattern": {
      "code_snippet": "#ifndef $GUARD\n#define $GUARD\n...\n#endif",
      "pattern_type": "code_pattern",
      "metavariables": {
        "$GUARD": {
          "type_hint": "expr",
          "regex": "^[A-Z][A-Z0-9_]*_H_$"

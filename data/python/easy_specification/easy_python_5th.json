    "rule_id": "python-decorator-judicious-use",
    "language": "python",
    "description": "Detect decorator usage that may indicate non-judicious application, such as decorators with external dependencies or complex logic.",
    "severity": "warning",
    "surface_pattern": {
      "code_snippet": "@$DECORATOR\ndef $FUNC(...):\n    ...",
      "pattern_type": "code_pattern",
      "metavariables": {

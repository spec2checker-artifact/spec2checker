    "rule_id": "python-lambda-prefer-operator",
    "language": "python",
    "description": "For common operations like multiplication, use functions from `operator` module instead of lambda.",
    "severity": "warning",
    "surface_pattern": {
      "code_snippet": "lambda $X, $Y: $X $OP $Y",
      "pattern_type": "code_pattern",
      "metavariables": {
        "$X": {
          "type_hint": "expr"
        },
        "$Y": {
          "type_hint": "expr"
        },
        "$OP": {
          "type_hint": "expr"
        }
      }
    },
    "context_constraints": [
      {
        "target": "$OP",
        "constraint_type": "syntactic",

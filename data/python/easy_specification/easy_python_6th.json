    "rule_id": "python-property-no-simple-getset",
    "language": "python",
    "description": "Using a property to simply get and set an internal attribute is not allowed; make the attribute public instead.",
    "severity": "warning",
    "surface_pattern": {
      "code_snippet": "@property\ndef $GETTER(...):\n    ...\n@$GETTER.setter\ndef $SETTER(...):\n    ...",
      "pattern_type": "code_pattern",
      "metavariables": {
        "$GETTER": {
          "type_hint": "function"
        },
        "$SETTER": {
          "type_hint": "function"
        }
      }
    },
    "context_constraints": [
      {
        "target": "$GETTER",
        "constraint_type": "syntactic",
        "condition": "body_is_return_self_attribute",
        "required": "true"
      },
      {
        "target": "$SETTER",
        "constraint_type": "syntactic",
        "condition": "body_is_assign_to_self_attribute",
        "required": "true"

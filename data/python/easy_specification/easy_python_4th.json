  {
    "rule_id": "python-property-decorator-required",
    "language": "python",
    "description": "Properties should be created with the `@property` decorator. Manual descriptor implementation is a power feature and should be flagged.",
    "severity": "warning",
    "surface_pattern": {
      "code_snippet": "def $PROP(...):\n    ...",
      "pattern_type": "code_pattern",
      "metavariables": {
        "$PROP": {
          "type_hint": "function",
          "regex": "^[a-z_][a-z0-9_]*$"
        }
      }
    },
    "context_constraints": [
      {
        "target": "$PROP",
        "constraint_type": "annotation",
        "condition": "not has_annotation('property')",
        "required": "true"
      },
      {
        "target": "$PROP",
        "constraint_type": "syntactic",
        "condition": "has_decorator_count(0)",
        "required": "true"
      },
      {
        "target": "$PROP",
        "constraint_type": "syntactic",
        "condition": "parameter_count(1)",
        "required": "true"
      },
      {
        "target": "$PROP",
        "constraint_type": "syntactic",
        "condition": "first_parameter_name('self')",
        "required": "true"
      }
    ],
    "dataflow_spec": null,

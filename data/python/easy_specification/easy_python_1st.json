  {
    "rule_id": "python-import-rename-as",
    "language": "python",
    "description": "Enforce use of 'as' for renaming imports when: imported name conflicts with another module, top-level name, common parameter, is inconveniently long, or is too generic. Also applies to standard abbreviations like 'numpy as np'.",
    "severity": "warning",
    "surface_pattern": {
      "code_snippet": "from $MODULE import $NAME",
      "pattern_type": "code_pattern",
      "metavariables": {
        "$MODULE": {
          "type_hint": "expr"
        },
        "$NAME": {
          "type_hint": "expr"
        }
      }
    },
    "context_constraints": [
      {
        "target": "$NAME",
        "constraint_type": "syntactic",
        "condition": "name_matches_regex('^(np|pd|plt|tf|np_|pd_|plt_|tf_|options|config|settings|data|file|path|value|key|item|list|dict|set|func|obj|cls|mod|sys|os|io|re|math|json|yaml|xml|log|logger|log_|log$|^[A-Z])')",
        "required": "false"
      }
    ],
    "dataflow_spec": null,
    "capabilities_required": {
      "cross_file": false,
      "inheritance_analysis": false,
      "dataflow": false,
      "type_resolution": false
    },
    "backend_hints": {
      "semgrep": {
        "partial_support": true,
        "needs_type_solver": false,
        "full_support": false,
        "limitations": "Cannot fully detect semantic conflicts (e.g., name collisions with other imports or local variables) without cross-file and scope analysis."
      },
      "pmd": {
        "partial_support": false,
        "needs_type_solver": false,
        "full_support": false,
        "limitations": "PMD does not support Python analysis."
      },
      "codeql": {
        "partial_support": true,
        "needs_type_solver": false,
        "full_support": false,
        "limitations": "Requires custom query to implement the full heuristic logic for when renaming is appropriate."
      }
    },
    "metadata": {
      "source_file": "D:\\Sepc2Checker\\data\\python\\easy_specification\\imports_use_renaming.txt",
      "section": "imports_use_renaming"
    }

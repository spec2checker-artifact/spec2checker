  {
    "rule_id": "python-none-check-is",
    "language": "python",
    "description": "Always use `if x is None` (or `is not None`) to check for `None`. Do not use `if not x:` when `x` could be `0` or `''`.",
    "severity": "warning",
    "surface_pattern": {
      "code_snippet": "if not $X:\n    ...",
      "pattern_type": "code_pattern",
      "metavariables": {
        "$X": {
          "type_hint": "expr"
        }
      }
    },
    "context_constraints": [
      {
        "target": "$X",
        "constraint_type": "type",
        "condition": "is_subtype_of('int') or is_subtype_of('str') or is_subtype_of('list') or is_subtype_of('dict') or is_subtype_of('bool')",
        "required": "true"
      }
    ],
    "dataflow_spec": null,

    "rule_id": "python-mutable-global-state",
    "language": "python",
    "description": "Detect mutable global state (module-level variables that are reassigned). Module-level constants are permitted.",
    "severity": "warning",
    "surface_pattern": {
      "code_snippet": "$VAR = $EXPR",
      "pattern_type": "code_pattern",
      "metavariables": {
        "$VAR": {
          "type_hint": "expr"
        },
        "$EXPR": {
          "type_hint": "expr"
        }
      }
    },
    "context_constraints": [
      {
        "target": "$VAR",
        "constraint_type": "scope",
        "condition": "is_module_scope",
        "required": "true"
      },
      {
        "target": "$VAR",
        "constraint_type": "syntactic",
        "condition": "is_assignment_target",
        "required": "true"
      }
    ],
    "dataflow_spec": null,

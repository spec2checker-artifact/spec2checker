        "needs_type_solver": true,
        "full_support": false,
        "limitations": "Type resolution needed to filter out non-nullable types; may have false positives without type info."
      },
      "pmd": {
        "partial_support": false,
        "needs_type_solver": false,
        "full_support": false,
        "limitations": "PMD does not support Python analysis."
      },
      "codeql": {
        "partial_support": true,
        "needs_type_solver": true,
        "full_support": false,

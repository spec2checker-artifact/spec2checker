  {
    "rule_id": "python-avoid-todo-individual-context",
    "language": "python",
    "description": "Avoid adding TODO comments that refer to an individual or team as the context. Use an issue tracker instead.",
    "severity": "warning",
    "surface_pattern": {
      "code_snippet": "# TODO: $PREFIX$USER$SUFFIX",
      "pattern_type": "code_pattern",
      "metavariables": {
        "$USER": {
          "type_hint": "expr",
          "regex": "@?[a-zA-Z0-9_-]+"
        }
      }
    },
    "context_constraints": [
      {
        "target": "comment",
        "constraint_type": "syntactic",
        "condition": "matches_regex('TODO.*@')",
        "required": "true"
      }
    ],
    "dataflow_spec": null,
    "capabilities_required": {
      "cross_file": false,
      "inheritance_analysis": false,
      "dataflow": false,
      "type_resolution": false
    },
    "backend_hints": {
      "semgrep": {
        "partial_support": true,
        "needs_type_solver": false,
        "full_support": false,
        "limitations": "regex matching on comments may have false positives"
      },
      "pmd": {
        "partial_support": false,
        "needs_type_solver": false,
        "full_support": false,
        "limitations": "PMD does not support Python analysis"
      },
      "codeql": {
        "partial_support": true,
        "needs_type_solver": false,
        "full_support": false,
        "limitations": "requires custom query for comment pattern matching"
      }
    },

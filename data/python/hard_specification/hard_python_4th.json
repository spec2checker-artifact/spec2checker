          "type_hint": "expr"
        },
        "$METHOD": {
          "type_hint": "expr"
        },
        "$ARG": {
          "type_hint": "expr"
        }
      }
    },
    "context_constraints": [
      {
        "target": "$METHOD",
        "constraint_type": "syntactic",
        "condition": "name_matches_regex('^(debug|info|warning|error|critical|exception|log)$')",
        "required": "true"
      },
      {
        "target": "$ARG",
        "constraint_type": "syntactic",
        "condition": "is_not_string_literal",
        "required": "true"

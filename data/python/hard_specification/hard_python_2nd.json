  {
    "rule_id": "python-getter-setter-unnecessary",
    "language": "python",
    "description": "Getter and setter functions should only be used when getting/setting is complex or costly; for simple read/write, make the attribute public.",
    "severity": "warning",
    "surface_pattern": {
      "code_snippet": "def get_$NAME($SELF):\n    return $SELF.$ATTR",
      "pattern_type": "code_pattern",
      "metavariables": {
        "$NAME": {
          "type_hint": "function",
          "regex": "^[a-z_][a-z0-9_]*$"
        },
        "$SELF": {
          "type_hint": "expr"
        },
        "$ATTR": {
          "type_hint": "expr"
        }
      }
    },
    "context_constraints": [
      {
        "target": "function",
        "constraint_type": "syntactic",
        "condition": "body_is_single_return_attribute",
        "required": "true"
      },
      {
        "target": "function",
        "constraint_type": "scope",
        "condition": "is_method_of_class",
        "required": "true"
      }
    ],
    "dataflow_spec": null,

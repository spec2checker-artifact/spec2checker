  {
    "rule_id": "python-type-alias-naming",
    "language": "python",
    "description": "Type aliases must be named using CapWords. If the alias is private to the module, it must be prefixed with an underscore. Use the explicit TypeAlias annotation (Python 3.10+).",
    "severity": "warning",
    "surface_pattern": {
      "code_snippet": "$ALIAS: TypeAlias = $EXPR",
      "pattern_type": "code_pattern",
      "metavariables": {
        "$ALIAS": {
          "type_hint": "expr"
        }
      }
    },
    "context_constraints": [
      {
        "target": "$ALIAS",
        "constraint_type": "syntactic",
        "condition": "name_matches_regex('^[A-Z][a-zA-Z0-9]*$')",
        "required": "false"
      }
    ],
    "dataflow_spec": null,
    "capabilities_required": {
      "cross_file": false,
      "inheritance_analysis": false,
      "dataflow": false,
      "type_resolution": false
    },
    "backend_hints": {
      "semgrep": {
        "partial_support": true,
        "needs_type_solver": false,
        "full_support": false,
        "limitations": "Cannot reliably detect if alias is used only within the module to enforce underscore prefix."
      },
      "pmd": {
        "partial_support": false,
        "needs_type_solver": false,
        "full_support": false,
        "limitations": "PMD does not support Python analysis."
      },
      "codeql": {
        "partial_support": true,
        "needs_type_solver": true,
        "full_support": false,
        "limitations": "Requires type resolution for complex type expressions and cross-file analysis for module-private detection."
      }
    },
    "metadata": {
      "source_file": "D:\\Sepc2Checker\\data\\python\\hard_specification\\aliases_capworded_private.txt",
      "section": "aliases_capworded_private"
    }

    "description": "For logging functions that expect a pattern-string, always call them with a string literal (not f-string) as first argument.",
    "severity": "warning",
    "surface_pattern": {
      "code_snippet": "$LOGGER.$METHOD($FORMAT, ...)",
      "pattern_type": "code_pattern",
      "metavariables": {
        "$LOGGER": {
          "type_hint": "expr"
        },
        "$METHOD": {
          "type_hint": "expr"
        },
        "$FORMAT": {
          "type_hint": "expr"
        }
      }
    },
    "context_constraints": [
      {
        "target": "$METHOD",
        "constraint_type": "syntactic",
        "condition": "name_matches_regex('^(debug|info|warning|error|critical|exception|log)$')",
        "required": "true"
      },
      {
        "target": "$FORMAT",
        "constraint_type": "syntactic",
        "condition": "is_not_string_literal",
        "required": "true"

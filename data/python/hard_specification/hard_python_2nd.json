  {
    "rule_id": "python-docstring-omit-return-none",
    "language": "python",
    "description": "The Returns section is not required if the function only returns None. It may be omitted if the docstring starts with 'Return', 'Returns', etc.",
    "severity": "warning",
    "surface_pattern": {
      "code_snippet": "def $FUNC(...):\n    \"\"\"$DOCSTRING\"\"\"\n    ...",
      "pattern_type": "code_pattern",
      "metavariables": {
        "$FUNC": {
          "type_hint": "function"
        },
        "$DOCSTRING": {
          "type_hint": "expr"
        }
      }
    },
    "context_constraints": [
      {
        "target": "function",
        "constraint_type": "type",
        "condition": "returns_type('None')",
        "required": "true"
      },
      {
        "target": "$DOCSTRING",
        "constraint_type": "syntactic",
        "condition": "contains_section('Returns')",
        "required": "true"
      }
    ],
    "dataflow_spec": null,
    "capabilities_required": {
      "cross_file": false,
      "inheritance_analysis": false,
      "dataflow": false,
      "type_resolution": true
    },
    "backend_hints": {
      "semgrep": {
        "partial_support": true,
        "needs_type_solver": true,
        "full_support": false,
        "limitations": "requires type resolution to confirm function returns None; docstring parsing is limited"
      },
      "pmd": {
        "partial_support": false,
        "needs_type_solver": false,
        "full_support": false,
        "limitations": "PMD does not support Python analysis"
      },
      "codeql": {
        "partial_support": true,
        "needs_type_solver": true,
        "full_support": false,
        "limitations": "requires custom query for docstring section detection"
      }
    },
    "metadata": {
      "source_file": "D:\\Sepc2Checker\\data\\python\\hard_specification\\function_docstring_section.txt",
      "section": "function_docstring_section"
    }

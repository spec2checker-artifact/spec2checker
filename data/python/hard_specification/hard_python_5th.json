    "rule_id": "python-forward-declaration-import",
    "language": "python",
    "description": "Detect forward references to class names without using `from __future__ import annotations` or string literals.",
    "severity": "warning",
    "surface_pattern": {
      "code_snippet": "$CLASSNAME",
      "pattern_type": "code_pattern",
      "metavariables": {

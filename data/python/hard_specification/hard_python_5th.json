          "type_hint": "expr",
          "regex": "^[A-Z][a-zA-Z0-9]*$"
        }
      }
    },
    "context_constraints": [
      {
        "target": "$CLASSNAME",
        "constraint_type": "type",
        "condition": "is_forward_reference",
        "required": "true"

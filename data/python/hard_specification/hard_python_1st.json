  {
    "rule_id": "python-naming-internal-underscore",
    "language": "python",
    "description": "Detect names that should be internal (private/protected) but do not start with a single underscore. Internal names are those defined in a module or class that are not intended for public use.",
    "severity": "warning",
    "surface_pattern": {
      "code_snippet": "$NAME = $EXPR",
      "pattern_type": "code_pattern",
      "metavariables": {
        "$NAME": {
          "type_hint": "expr",
          "regex": "^[a-zA-Z_][a-zA-Z0-9_]*$"
        }
      }
    },
    "context_constraints": [
      {
        "target": "$NAME",
        "constraint_type": "syntactic",
        "condition": "name_matches_regex('^[^_].*')",
        "required": "true"
      },
      {
        "target": "$NAME",
        "constraint_type": "scope",
        "condition": "is_private_or_protected",
        "required": "true"
      }
    ],
    "dataflow_spec": null,
    "capabilities_required": {
      "cross_file": false,
      "inheritance_analysis": false,
      "dataflow": false,
      "type_resolution": false

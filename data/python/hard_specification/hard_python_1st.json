        "partial_support": true,
        "needs_type_solver": false,
        "full_support": false,
        "limitations": "Scope detection for 'private_or_protected' may be approximate; may not handle all cases of intended public vs internal naming."
      },
      "pmd": {
        "partial_support": false,
        "needs_type_solver": false,
        "full_support": false,
        "limitations": "PMD does not support Python analysis."
      },
      "codeql": {
        "partial_support": true,
        "needs_type_solver": false,

  {
    "rule_id": "python-docstring-sections",
    "language": "python",
    "description": "Function docstring must contain sections: Args, Returns (or Yields), and Raises with proper hanging indent.",
    "severity": "warning",
    "surface_pattern": {
      "code_snippet": "def $FUNC(...):\n    \"\"\"$DOC\"\"\"\n    ...",
      "pattern_type": "code_pattern",
      "metavariables": {
        "$FUNC": {
          "type_hint": "function"
        },
        "$DOC": {
          "type_hint": "expr"
        }
      }
    },
    "context_constraints": [
      {
        "target": "$DOC",
        "constraint_type": "syntactic",
        "condition": "not_contains_section('Args')",
        "required": "true"
      },
      {
        "target": "$DOC",
        "constraint_type": "syntactic",
        "condition": "not_contains_section('Returns') and not_contains_section('Yields')",
        "required": "true"
      },
      {
        "target": "$DOC",
        "constraint_type": "syntactic",
        "condition": "not_contains_section('Raises')",
        "required": "true"
      }
    ],
    "dataflow_spec": null,

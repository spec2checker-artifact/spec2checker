  {
    "rule_id": "javascript-es-module-import-naming",
    "language": "javascript",
    "description": "Module import names (`import * as name`) should be in lowerCamelCase, derived from the file name. Exception: 'THREE' for threejs.",
    "severity": "warning",
    "surface_pattern": {
      "code_snippet": "import * as $NAME from $SOURCE;",
      "pattern_type": "code_pattern",
      "metavariables": {
        "$NAME": {
          "type_hint": "expr"
        }
      }
    },
    "context_constraints": [
      {
        "target": "$NAME",
        "constraint_type": "syntactic",
        "condition": "name_matches_regex('^[a-z][a-zA-Z0-9]*$')",
        "required": "false"
      },
      {
        "target": "$NAME",
        "constraint_type": "syntactic",
        "condition": "name_not_equals('THREE')",
        "required": "true"
      }
    ],
    "dataflow_spec": null,
    "capabilities_required": {
      "cross_file": false,
      "inheritance_analysis": false,
      "dataflow": false,
      "type_resolution": false
    },
    "backend_hints": {
      "semgrep": {
        "partial_support": true,
        "needs_type_solver": false,
        "full_support": false,
        "limitations": "requires regex matching on metavariable name"
      },
      "pmd": {
        "partial_support": false,
        "needs_type_solver": false,
        "full_support": false,
        "limitations": "PMD does not support JavaScript/ES module analysis"
      },
      "codeql": {
        "partial_support": true,
        "needs_type_solver": false,
        "full_support": false,
        "limitations": "requires custom query for naming convention"
      }
    },
    "metadata": {

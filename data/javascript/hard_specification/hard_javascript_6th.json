  {
    "rule_id": "javascript-number-literal-prefix-case",
    "language": "javascript",
    "description": "Number literals must use lowercase letters in hex (0x), octal (0o), and binary (0b) prefixes. Leading zeros are prohibited unless followed by x, o, or b.",
    "severity": "error",
    "surface_pattern": {
      "code_snippet": "$NUM",
      "pattern_type": "code_pattern",
      "metavariables": {
        "$NUM": {
          "type_hint": "expr"
        }
      }
    },
    "context_constraints": [
      {
        "target": "$NUM",
        "constraint_type": "syntactic",
        "condition": "matches_regex('^0[0-9]+$')",
        "required": "true"
      },
      {
        "target": "$NUM",
        "constraint_type": "syntactic",
        "condition": "not matches_regex('^0[xob][0-9a-fA-F_]+$')",
        "required": "true"
      }
    ],
    "dataflow_spec": null,
    "capabilities_required": {
      "cross_file": false,
      "inheritance_analysis": false,
      "dataflow": false,
      "type_resolution": false
    },
    "backend_hints": {
      "semgrep": {
        "partial_support": true,
        "needs_type_solver": false,
        "full_support": false,
        "limitations": "requires regex matching on numeric literal tokens"
      },
      "pmd": {
        "partial_support": false,
        "needs_type_solver": false,
        "full_support": false,
        "limitations": "PMD does not support JavaScript analysis"
      },
      "codeql": {
        "partial_support": true,
        "needs_type_solver": false,
        "full_support": false,
        "limitations": "requires custom query for literal token text"
      }
    },
    "metadata": {
      "source_file": "D:\\Sepc2Checker\\data\\javascript\\hard_specification\\literals_lowercase_letters.txt",
      "section": "literals_lowercase_letters"
    }

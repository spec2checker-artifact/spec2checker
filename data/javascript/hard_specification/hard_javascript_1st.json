  {
    "rule_id": "javascript-tostring-override-side-effects",
    "language": "javascript",
    "description": "toString may be overridden but must always succeed and never have visible side effects. Avoid calling other methods that may throw.",
    "severity": "warning",
    "surface_pattern": {
      "code_snippet": "public String toString() {\n    $BODY\n}",
      "pattern_type": "code_pattern",
      "metavariables": {
        "$BODY": {
          "type_hint": "expr"
        }
      }
    },
    "context_constraints": [
      {
        "target": "method",
        "constraint_type": "inheritance",
        "condition": "overrides_method('java.lang.Object.toString')",
        "required": "true"
      }
    ],
    "dataflow_spec": null,
    "capabilities_required": {
      "cross_file": false,
      "inheritance_analysis": true,
      "dataflow": false,
      "type_resolution": true
    },
    "backend_hints": {
      "semgrep": {
        "partial_support": true,
        "needs_type_solver": false,
        "full_support": false,
        "limitations": "Cannot fully verify absence of side effects or success guarantee; pattern matches all toString overrides."
      },
      "pmd": {
        "partial_support": true,
        "needs_type_solver": false,
        "full_support": false,
        "limitations": "PMD has rules for Law of Demeter and exception handling, but not a specific rule for side effects in toString."
      },
      "codeql": {
        "partial_support": true,
        "needs_type_solver": true,
        "full_support": false,
        "limitations": "Can detect calls to methods that may throw, but full side-effect analysis is complex."

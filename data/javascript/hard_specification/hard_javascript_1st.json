    "rule_id": "javascript-no-nested-namespace",
    "language": "javascript",
    "description": "Do not define a nested type (class, typedef, enum, interface) on another module-local name. Use top-level exports.",
    "severity": "warning",
    "surface_pattern": {
      "code_snippet": "$MODULE.$NESTED = $DEF",
      "pattern_type": "code_pattern",
      "metavariables": {
        "$MODULE": {
          "type_hint": "expr"
        },
        "$NESTED": {
          "type_hint": "expr"
        },
        "$DEF": {
          "type_hint": "expr"
        }
      }
    },
    "context_constraints": [
      {
        "target": "$DEF",
        "constraint_type": "syntactic",
        "condition": "is_class_or_function_or_enum",
        "required": "true"
      }
    ],
    "dataflow_spec": null,
    "capabilities_required": {

    "rule_id": "javascript-number-literal-prefix-case",
    "language": "javascript",
    "description": "Use `0x`, `0o`, `0b` prefixes with lowercase letters. Never include leading zero unless followed by `x`, `o`, `b`.",
    "severity": "warning",
    "surface_pattern": {
      "code_snippet": "$NUM",
      "pattern_type": "code_pattern",
      "metavariables": {
        "$NUM": {
          "type_hint": "expr"
        }
      }
    },
    "context_constraints": [
      {
        "target": "$NUM",
        "constraint_type": "syntactic",
        "condition": "matches_regex('^0[0-9]+')",
        "required": "true"

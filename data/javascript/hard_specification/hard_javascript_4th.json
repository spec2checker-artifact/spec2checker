  {
    "rule_id": "javascript-local-variable-declaration-timing",
    "language": "javascript",
    "description": "Local variables should be declared close to their first use, not at the start of a block, to minimize their scope. They should be initialized as soon as possible.",
    "severity": "warning",
    "surface_pattern": {
      "code_snippet": "let $VAR;\n...\n$VAR = $EXPR;",
      "pattern_type": "code_pattern",
      "metavariables": {
        "$VAR": {
          "type_hint": "expr"
        },
        "$EXPR": {
          "type_hint": "expr"
        }
      }
    },
    "context_constraints": [
      {
        "target": "$VAR",
        "constraint_type": "scope",
        "condition": "same_block",
        "required": "true"
      }
    ],
    "dataflow_spec": null,
    "capabilities_required": {
      "cross_file": false,
      "inheritance_analysis": false,
      "dataflow": false,
      "type_resolution": false
    },
    "backend_hints": {
      "semgrep": {
        "partial_support": true,
        "needs_type_solver": false,
        "full_support": false,
        "limitations": "Pattern may match acceptable uses where declaration cannot be combined with initialization (e.g., variable used in multiple branches)."
      },
      "pmd": {
        "partial_support": false,
        "needs_type_solver": false,
        "full_support": false,
        "limitations": "PMD does not support JavaScript analysis."
      },
      "codeql": {
        "partial_support": true,
        "needs_type_solver": false,
        "full_support": false,
        "limitations": "Requires custom query to detect declaration far from first assignment."
      }
    },
    "metadata": {
      "source_file": "D:\\Sepc2Checker\\data\\javascript\\hard_specification\\variables_initialized.txt",
      "section": "variables_initialized"
    }

    "rule_id": "javascript-no-builtin-modification",
    "language": "javascript",
    "description": "Detects modifications to built-in object prototypes or constructors, such as adding methods to Array.prototype or Object. Modifying built-in types is forbidden. JSCompiler polyfills are an allowed exception.",
    "severity": "error",
    "surface_pattern": {
      "code_snippet": "$BUILTIN.prototype.$PROP = $EXPR",
      "pattern_type": "code_pattern",
      "metavariables": {
        "$BUILTIN": {
          "type_hint": "expr",
          "regex": "^(Array|Object|String|Number|Boolean|Function|Date|RegExp|Error|Map|Set|Promise)$"
        },
        "$PROP": {
          "type_hint": "expr"
        }
      }
    },
    "context_constraints": null,
    "dataflow_spec": null,

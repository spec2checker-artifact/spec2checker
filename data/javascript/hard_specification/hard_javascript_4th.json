  {
    "rule_id": "javascript-string-single-quotes",
    "language": "javascript",
    "description": "Ordinary string literals must be delimited with single quotes `'`, not double quotes `\"`. May not span multiple lines. Use template strings to avoid escaping single quotes.",
    "severity": "warning",
    "surface_pattern": {
      "code_snippet": "\"$STRING\"",
      "pattern_type": "code_pattern",
      "metavariables": {
        "$STRING": {
          "type_hint": "expr"
        }
      }
    },
    "context_constraints": [
      {
        "target": "$STRING",
        "constraint_type": "syntactic",
        "condition": "not_contains('\\n')",
        "required": "true"
      }
    ],
    "dataflow_spec": null,
    "capabilities_required": {

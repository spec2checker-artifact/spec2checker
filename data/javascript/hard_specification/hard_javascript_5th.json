  {
    "rule_id": "javascript-prefer-for-of",
    "language": "javascript",
    "description": "Prefer `for-of` loops for iterating over arrays and iterables. `for-in` loops should only be used for dict-style objects and must use `hasOwnProperty` check.",
    "severity": "warning",
    "surface_pattern": {
      "code_snippet": "for (const $VAR in $ITERABLE) { ... }",
      "pattern_type": "code_pattern",
      "metavariables": {
        "$VAR": {
          "type_hint": "expr"
        },
        "$ITERABLE": {
          "type_hint": "expr"
        }
      }
    },
    "context_constraints": [
      {
        "target": "$ITERABLE",
        "constraint_type": "type",
        "condition": "is_array_type",
        "required": "true"
      }
    ],
    "dataflow_spec": null,
    "capabilities_required": {
      "cross_file": false,
      "inheritance_analysis": false,
      "dataflow": false,
      "type_resolution": true

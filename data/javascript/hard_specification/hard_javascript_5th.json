    "severity": "warning",
    "surface_pattern": {
      "code_snippet": "/** @enum {$TYPE} */\nconst $NAME = $OBJ;",
      "pattern_type": "code_pattern",
      "metavariables": {
        "$TYPE": {
          "type_hint": "expr"
        },
        "$NAME": {
          "type_hint": "expr"
        },
        "$OBJ": {
          "type_hint": "expr"
        }
      }
    },
    "context_constraints": [
      {
        "target": "$OBJ",
        "constraint_type": "syntactic",
        "condition": "is_object_literal",

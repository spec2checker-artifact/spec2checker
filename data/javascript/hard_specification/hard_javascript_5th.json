      {
        "target": "$OBJ",
        "constraint_type": "syntactic",
        "condition": "all_property_values_are_literals",
        "required": "true"
      },
      {
        "target": "$NAME",
        "constraint_type": "scope",
        "condition": "is_constant",
        "required": "true"
      }
    ],
    "dataflow_spec": null,

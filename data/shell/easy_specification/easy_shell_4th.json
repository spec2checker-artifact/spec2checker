    "rule_id": "shell-single-string-command-args",
    "language": "shell",
    "description": "Using a single string for multiple command arguments should be avoided; leads to eval or quoting nightmares.",
    "severity": "warning",
    "surface_pattern": {
      "code_snippet": "$CMD $FLAGS",
      "pattern_type": "code_pattern",
      "metavariables": {
        "$FLAGS": {
          "type_hint": "expr",

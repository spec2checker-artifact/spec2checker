    "severity": "warning",
    "surface_pattern": {
      "code_snippet": "case $VAR in\n    $PATTERN) $CMD;;\n    ...\nesac",
      "pattern_type": "code_pattern",
      "metavariables": {
        "$VAR": {
          "type_hint": "expr"
        },
        "$PATTERN": {
          "type_hint": "expr"
        },
        "$CMD": {
          "type_hint": "expr"
        }
      }
    },
    "context_constraints": [
      {
        "target": "$CMD",
        "constraint_type": "syntactic",
        "condition": "is_on_same_line_as('$PATTERN)')",
        "required": "true"
      },
      {
        "target": "$CMD",
        "constraint_type": "syntactic",
        "condition": "is_immediately_followed_by(';;')",
        "required": "true"
      },
      {
        "target": "$CMD",
        "constraint_type": "syntactic",
        "condition": "is_not_preceded_by(' ')",
        "required": "true"
      }

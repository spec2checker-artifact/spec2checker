[
  {
    "rule_id": "shell-quote-integer-variables",
    "language": "shell",
    "description": "Optionally quote shell-internal, readonly special variables that are integers: $?, $#, $$, $!. Prefer quoting named internal integer variables (e.g., PPID) for consistency. It's ok to not quote inside (( )).",
    "severity": "warning",
    "surface_pattern": {
      "code_snippet": "$VAR",
      "pattern_type": "code_pattern",
      "metavariables": {
        "$VAR": {
          "type_hint": "expr",
          "regex": "^(\\$[?#!$]|\\$\\{[?#!$]\\}|\\$PPID|\\$\\{PPID\\})$"
        }
      }
    },
    "context_constraints": [
      {
        "target": "$VAR",
        "constraint_type": "syntactic",
        "condition": "not_inside_arithmetic_expansion",
        "required": "true"
      }
    ],
    "dataflow_spec": null,
    "capabilities_required": {
      "cross_file": false,
      "inheritance_analysis": false,
      "dataflow": false,
      "type_resolution": false
    },
    "backend_hints": {
      "semgrep": {
        "partial_support": true,
        "needs_type_solver": false,
        "full_support": false,
        "limitations": "Semgrep for shell may not fully parse arithmetic context (( ))."
      },
      "pmd": {
        "partial_support": false,
        "needs_type_solver": false,
        "full_support": false,
        "limitations": "PMD does not support shell analysis."
      },
      "codeql": {
        "partial_support": false,
        "needs_type_solver": false,
        "full_support": false,
        "limitations": "CodeQL does not support shell analysis."
      }
    },
    "metadata": {
      "source_file": "D:\\Sepc2Checker\\data\\shell\\easy_specification\\optionally_variables.txt",
      "section": "optionally_variables"
    }
  },

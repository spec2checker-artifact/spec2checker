    "severity": "warning",
    "surface_pattern": {
      "code_snippet": "if (( $${VAR} $OP $${VAR2} )); then",
      "pattern_type": "code_pattern",
      "metavariables": {
        "$VAR": {
          "type_hint": "expr"
        },
        "$VAR2": {
          "type_hint": "expr"
        },
        "$OP": {
          "type_hint": "expr"
        }
      }
    },
    "context_constraints": [
      {
        "target": "$VAR",
        "constraint_type": "syntactic",
        "condition": "name_starts_with('$')",

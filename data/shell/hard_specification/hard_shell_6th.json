    "rule_id": "shell-loop-variable-naming",
    "language": "shell",
    "description": "Loop variable names should be similarly named for the collection being iterated over.",
    "severity": "warning",
    "surface_pattern": {
      "code_snippet": "for $VAR in $ITERABLE; do\n    ...\ndone",
      "pattern_type": "code_pattern",
      "metavariables": {
        "$VAR": {
          "type_hint": "expr"
        },
        "$ITERABLE": {
          "type_hint": "expr"
        }
      }
    },
    "context_constraints": [
      {
        "target": "$VAR",
        "constraint_type": "syntactic",
        "condition": "name_matches_regex('^[a-z][a-z0-9_]*$')",
        "required": "true"
      },
      {
        "target": "$ITERABLE",
        "constraint_type": "syntactic",
        "condition": "name_matches_regex('^[a-z][a-z0-9_]*$')",
        "required": "true"
      }
    ],
    "dataflow_spec": null,

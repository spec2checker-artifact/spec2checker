  {
    "rule_id": "shell-array-expansion-quoting",
    "language": "shell",
    "description": "Use \"${array[@]}\" expansion to preserve individual elements and quoting.",
    "severity": "warning",
    "surface_pattern": {
      "code_snippet": "$CMD $ARRAY",
      "pattern_type": "code_pattern",
      "metavariables": {
        "$CMD": {
          "type_hint": "expr"
        },
        "$ARRAY": {
          "type_hint": "expr"
        }
      }
    },
    "context_constraints": [
      {
        "target": "$ARRAY",
        "constraint_type": "syntactic",
        "condition": "name_matches_regex('^\\$[A-Za-z_][A-Za-z0-9_]*$')",
        "required": "true"
      },
      {
        "target": "$ARRAY",
        "constraint_type": "syntactic",
        "condition": "not name_matches_regex('^\\$\\{[A-Za-z_][A-Za-z0-9_]*\\[@\\]\\}$')",
        "required": "true"
      }
    ],
    "dataflow_spec": null,
    "capabilities_required": {
      "cross_file": false,
      "inheritance_analysis": false,
      "dataflow": false,
      "type_resolution": false
    },

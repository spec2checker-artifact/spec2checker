  {
    "rule_id": "shell-set-constant-readonly",
    "language": "shell",
    "description": "Detect when a variable is set (potentially at runtime or conditionally) but not made readonly immediately afterwards.",
    "severity": "warning",
    "surface_pattern": {
      "code_snippet": "$VAR=\"...\"\n...",
      "pattern_type": "code_pattern",
      "metavariables": {
        "$VAR": {
          "type_hint": "expr"
        }
      }
    },
    "context_constraints": [
      {
        "target": "$VAR",
        "constraint_type": "syntactic",
        "condition": "not_followed_by('readonly $VAR')",
        "required": "true"
      }
    ],
    "dataflow_spec": null,
    "capabilities_required": {
      "cross_file": false,
      "inheritance_analysis": false,
      "dataflow": false,
      "type_resolution": false
    },
    "backend_hints": {
      "semgrep": {
        "partial_support": true,
        "needs_type_solver": false,
        "full_support": false,
        "limitations": "Semgrep for shell may have limited scope tracking; pattern may not correctly enforce 'immediately afterwards' across complex control flow."
      },
      "pmd": {
        "partial_support": false,
        "needs_type_solver": false,
        "full_support": false,
        "limitations": "PMD does not support shell script analysis."
      },
      "codeql": {
        "partial_support": false,
        "needs_type_solver": false,
        "full_support": false,
        "limitations": "CodeQL does not support shell script analysis."
      }
    },

    "rule_id": "shell-regex-rhs-no-quotes",
    "language": "shell",
    "description": "When using the regex matching operator `=~` inside `[[ ... ]]`, the right-hand side (RHS) should not be quoted, as quoting would cause it to be treated as a literal string instead of a regular expression.",
    "severity": "warning",
    "surface_pattern": {
      "code_snippet": "[[ $LHS =~ $RHS ]]",
      "pattern_type": "code_pattern",
      "metavariables": {
        "$LHS": {
          "type_hint": "expr"
        },
        "$RHS": {
          "type_hint": "expr"
        }
      }
    },
    "context_constraints": [
      {
        "target": "$RHS",
        "constraint_type": "syntactic",
        "condition": "is_quoted_string",
        "required": "true"
      }
    ],
    "dataflow_spec": null,
    "capabilities_required": {
      "cross_file": false,
      "inheritance_analysis": false,
      "dataflow": false,
      "type_resolution": false
    },
    "backend_hints": {
      "semgrep": {
        "partial_support": true,
        "needs_type_solver": false,
        "full_support": false,
        "limitations": "Semgrep's Bash/Shell support may not fully resolve variable expansions to determine if the RHS is a quoted literal."
      },
      "pmd": {
        "partial_support": false,
        "needs_type_solver": false,
        "full_support": false,
        "limitations": "PMD does not support Shell/Bash analysis."
      },
      "codeql": {
        "partial_support": true,
        "needs_type_solver": false,

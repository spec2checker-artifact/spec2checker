    "rule_id": "java-switch-block-style-mix",
    "language": "java",
    "description": "Detect mixing of new-style switch rules (label ->) and old-style statement groups (label:) within the same switch block.",
    "severity": "warning",
    "surface_pattern": {
      "code_snippet": "switch ($EXPR) {\n    $...BODY\n}",
      "pattern_type": "code_pattern",
      "metavariables": {
        "$EXPR": {
          "type_hint": "expr"
        },
        "$...BODY": {
          "type_hint": "expr"
        }
      }
    },
    "context_constraints": [
      {
        "target": "$...BODY",
        "constraint_type": "syntactic",
        "condition": "contains_pattern('case $L ->')",
        "required": "true"
      },
      {
        "target": "$...BODY",
        "constraint_type": "syntactic",
        "condition": "contains_pattern('case $L:')",
        "required": "true"

    "rule_id": "java-type-use-annotation-position",
    "language": "java",
    "description": "Type-use annotations must appear immediately before the annotated type and be meta-annotated with @Target(ElementType.TYPE_USE).",
    "severity": "error",
    "surface_pattern": {
      "code_snippet": "@$ANNOTATION $TYPE $VAR;",
      "pattern_type": "code_pattern",
      "metavariables": {
        "$ANNOTATION": {
          "type_hint": "expr"
        },
        "$TYPE": {
          "type_hint": "expr"
        },
        "$VAR": {
          "type_hint": "expr"
        }
      }
    },
    "context_constraints": [
      {
        "target": "$ANNOTATION",
        "constraint_type": "annotation",
        "condition": "has_meta_annotation('java.lang.annotation.Target', 'java.lang.annotation.ElementType.TYPE_USE')",
        "required": "true"
      },
      {
        "target": "$ANNOTATION",
        "constraint_type": "syntactic",
        "condition": "is_immediately_before($TYPE)",
        "required": "true"
      }
    ],
    "dataflow_spec": null,

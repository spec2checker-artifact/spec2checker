  {
    "rule_id": "java-switch-exhaustiveness",
    "language": "java",
    "description": "Every switch statement must be exhaustive, requiring a default case even if it only contains a break statement. Switches over enums that explicitly cover all known values are considered exhaustive without a default case.",
    "severity": "error",
    "surface_pattern": {
      "code_snippet": "switch ($EXPR) {\n    $CASES\n}",
      "pattern_type": "code_pattern",
      "metavariables": {
        "$EXPR": {
          "type_hint": "expr"
        },
        "$CASES": {
          "type_hint": "expr"
        }
      }
    },
    "context_constraints": [
      {
        "target": "switch",
        "constraint_type": "syntactic",
        "condition": "missing_default_case",
        "required": "true"
      },
      {
        "target": "$EXPR",
        "constraint_type": "type",
        "condition": "is_not_enum_type",
        "required": "true"
      }
    ],
    "dataflow_spec": null,
    "capabilities_required": {
      "cross_file": false,
      "inheritance_analysis": false,
      "dataflow": false,
      "type_resolution": true
    },
    "backend_hints": {
      "semgrep": {
        "partial_support": true,
        "needs_type_solver": true,
        "full_support": false,
        "limitations": "Cannot reliably determine if all enum values are covered without type resolution."
      },
      "pmd": {
        "partial_support": true,
        "needs_type_solver": true,
        "full_support": false,
        "limitations": "PMD's MissingSwitchDefault rule does not consider enum coverage."
      },
      "codeql": {
        "partial_support": true,
        "needs_type_solver": true,
        "full_support": false,
        "limitations": "Requires custom query to enforce default case even when enum is fully covered."
      }
    },
    "metadata": {
      "source_file": "D:\\Sepc2Checker\\data\\java\\hard_specification\\exhaustiveness_required.txt",
      "section": "exhaustiveness_required"
    }
  },

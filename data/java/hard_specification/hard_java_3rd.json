        "$CASES": {
          "type_hint": "expr"
        }
      }
    },
    "context_constraints": [
      {
        "target": "switch",
        "constraint_type": "syntactic",
        "condition": "missing_default_case",
        "required": "true"
      },
      {
        "target": "$EXPR",
        "constraint_type": "type",
        "condition": "is_enum_type",
        "required": "false"
      }
    ],
    "dataflow_spec": null,

    "rule_id": "java-switch-exhaustiveness",
    "language": "java",
    "description": "Every switch statement must be exhaustive, requiring a default case even if empty, unless all enum values are explicitly covered.",
    "severity": "error",
    "surface_pattern": {
      "code_snippet": "switch ($EXPR) {\n    $CASES\n}",
      "pattern_type": "code_pattern",
      "metavariables": {

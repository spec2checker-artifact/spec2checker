          "type_hint": "expr"
        },
        "$CASES": {
          "type_hint": "expr"
        }
      }
    },
    "context_constraints": [
      {
        "target": "switch",
        "constraint_type": "syntactic",
        "condition": "missing_default_clause",
        "required": "true"
      },
      {
        "target": "$EXPR",
        "constraint_type": "type",
        "condition": "type_is_not_enum",
        "required": "true"
      }
    ],
    "dataflow_spec": null,
    "capabilities_required": {

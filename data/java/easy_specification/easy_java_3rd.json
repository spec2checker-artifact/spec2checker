    "rule_id": "java-numeric-literal-long-suffix-uppercase",
    "language": "java",
    "description": "long-valued integer literals must use uppercase L suffix, never lowercase l, to avoid confusion with digit 1.",
    "severity": "error",
    "surface_pattern": {
      "code_snippet": "$NUMl",
      "pattern_type": "code_pattern",
      "metavariables": {
        "$NUM": {

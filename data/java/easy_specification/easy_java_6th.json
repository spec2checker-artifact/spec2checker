    "rule_id": "java-constant-naming-uppercase-snake",
    "language": "java",
    "description": "Constant names must use UPPER_SNAKE_CASE (all uppercase, words separated by single underscore). Applies only to static final fields with deeply immutable contents and no side-effect methods.",
    "severity": "warning",
    "surface_pattern": {
      "code_snippet": "$MODIFIERS $TYPE $NAME = $INIT;",
      "pattern_type": "code_pattern",
      "metavariables": {
        "$NAME": {
          "type_hint": "expr"
        }
      }
    },
    "context_constraints": [
      {
        "target": "field",
        "constraint_type": "syntactic",
        "condition": "has_modifiers('static', 'final')",
        "required": "true"
      },
      {
        "target": "field",
        "constraint_type": "syntactic",
        "condition": "name_matches_regex('^[A-Z][A-Z0-9]*(_[A-Z0-9]+)*$')",
        "required": "false"
      }
    ],
    "dataflow_spec": null,
    "capabilities_required": {

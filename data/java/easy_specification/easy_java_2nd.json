  {
    "rule_id": "java-assignment-break-after-symbol",
    "language": "java",
    "description": "Detect when an assignment operator or colon in an enhanced for loop is broken across lines, typically expecting the break after the symbol.",
    "severity": "warning",
    "surface_pattern": {
      "code_snippet": "$TYPE $VAR $OP\n    $EXPR;",
      "pattern_type": "code_pattern",
      "metavariables": {
        "$OP": {
          "type_hint": "expr",
          "regex": "=|:"
        }
      }
    },
    "context_constraints": [
      {
        "target": "statement",
        "constraint_type": "syntactic",
        "condition": "is_assignment_or_for_each",
        "required": "true"
      }
    ],
    "dataflow_spec": null,
    "capabilities_required": {
      "cross_file": false,
      "inheritance_analysis": false,
      "dataflow": false,
      "type_resolution": false
    },
    "backend_hints": {
      "semgrep": {
        "partial_support": true,
        "needs_type_solver": false,
        "full_support": false,
        "limitations": "Pattern may match other statements with similar line breaks."
      },
      "pmd": {
        "partial_support": true,
        "needs_type_solver": false,
        "full_support": false,
        "limitations": "Requires custom rule for line break detection."
      },
      "codeql": {
        "partial_support": true,
        "needs_type_solver": false,
        "full_support": false,
        "limitations": "Requires AST query for line positions."
      }
    },
    "metadata": {
      "source_file": "D:\\Sepc2Checker\\data\\java\\easy_specification\\assignment_operator_symbol.txt",
      "section": "assignment_operator_symbol"
    }

  {
    "rule_id": "java-non-constant-field-names",
    "language": "java",
    "description": "Non-constant field names (static or otherwise) should be written in lowerCamelCase, typically nouns or noun phrases.",
    "severity": "warning",
    "surface_pattern": {
      "code_snippet": "$TYPE $FIELD;",
      "pattern_type": "code_pattern",
      "metavariables": {
        "$FIELD": {
          "type_hint": "expr"
        }
      }
    },
    "context_constraints": [
      {
        "target": "$FIELD",
        "constraint_type": "syntactic",
        "condition": "name_matches_regex('^[a-z][a-zA-Z0-9]*$')",
        "required": "false"
      },
      {
        "target": "$FIELD",
        "constraint_type": "syntactic",
        "condition": "name_matches_regex('^[A-Z_][A-Z0-9_]*$')",
        "required": "false"
      }
    ],
    "dataflow_spec": null,
    "capabilities_required": {

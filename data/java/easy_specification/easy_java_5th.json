        "needs_type_solver": false,
        "full_support": false,
        "limitations": "requires pattern to match field declarations and exclude constants"
      },
      "pmd": {
        "partial_support": true,
        "needs_type_solver": false,
        "full_support": false,
        "limitations": "PMD has a rule 'FieldNamingConventions' that can be configured for this"
      },
      "codeql": {
        "partial_support": true,
        "needs_type_solver": false,
        "full_support": false,
        "limitations": "requires custom query to enforce lowerCamelCase and exclude constants"
      }
    },
